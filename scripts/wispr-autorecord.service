[Unit]
Description=Diktatūra auto-recorder (aptinka Slack skambučius, įrašo stereo WAV)
After=pulseaudio.service pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/env bash %h/wispr/scripts/autorecord.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

# Įdiegti (nuolat veiktų, net po perkrovimo):
