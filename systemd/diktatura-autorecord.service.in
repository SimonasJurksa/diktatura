[Unit]
Description=Diktatūra — Slack skambučių auto-įrašymas (stereo WAV: L=mic, R=sistema)
After=pulseaudio.service pipewire.service
# Vienu metu veikia tik vienas įrašymo režimas (make mode-slack / make mode-vox)
Conflicts=diktatura-vox.service

[Service]
Type=simple
ExecStart=/usr/bin/env bash @REPO@/bin/autorecord.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

# Šablonas: @REPO@ pakeičia `make install-units` (diegiama į ~/.config/systemd/user/).
# Logai: make logs   arba   journalctl --user -u diktatura-autorecord -f
